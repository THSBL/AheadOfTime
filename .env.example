# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: Google OAuth 2.0 Client ID for Google Calendar Integration (Google Identity Services)
VITE_GOOGLE_CLIENT_ID="705347156449-npiab082970nc26q27ln55g4ti4tj8i9.apps.googleusercontent.com"

# WHATSAPP_PHONE_NUMBER_ID: Meta WhatsApp Cloud API Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=

# WHATSAPP_BUSINESS_ACCOUNT_ID: Meta WhatsApp Business Account ID (WABA)
WHATSAPP_BUSINESS_ACCOUNT_ID=

# WHATSAPP_ACCESS_TOKEN: Permanent Meta System User Access Token with whatsapp_business_messaging permissions
WHATSAPP_ACCESS_TOKEN=

# WHATSAPP_VERIFY_TOKEN: Secret verification token configured in Meta App Dashboard for webhook validation
WHATSAPP_VERIFY_TOKEN="ahead_of_time_webhook_verify_secret"

# WHATSAPP_APP_SECRET: Meta App Secret (App Dashboard > Settings > Basic), used to verify the
# X-Hub-Signature-256 header on incoming webhook POSTs. Required in production; without it, the
# webhook accepts unsigned requests.
WHATSAPP_APP_SECRET=

# TELEGRAM_BOT_TOKEN: Telegram Bot Token provided by @BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=

# TELEGRAM_WEBHOOK_SECRET: Optional secret token sent in X-Telegram-Bot-Api-Secret-Token header
TELEGRAM_WEBHOOK_SECRET=

# VITE_GA_MEASUREMENT_ID: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# OWNER_TELEGRAM_CHAT_ID: The product owner's own Telegram chat id (obtained via /start
# on the bot, or @userinfobot). Bug-quality alerts and the weekly digest are sent ONLY to
# this chat id - never derived from user input, never broadcast to other users.
OWNER_TELEGRAM_CHAT_ID=

# CRON_SECRET: Shared secret checked on the Vercel Cron-triggered weekly report route
# (Authorization: Bearer $CRON_SECRET) so the endpoint can't be triggered by anyone else.
CRON_SECRET=

# --- Auto Sync & Notify: server-side Google OAuth (background sync) ---
# Distinct from VITE_GOOGLE_CLIENT_ID's implicit-flow usage everywhere else in
# the app (which can never produce a refresh token). This uses the SAME
# Google Cloud OAuth client, but the authorization-code flow, which needs a
# client secret and an authorized redirect URI registered in Google Cloud
# Console: <APP_URL>/api/auth/google/callback

# GOOGLE_OAUTH_CLIENT_SECRET: The OAuth client's secret (Google Cloud Console >
# APIs & Services > Credentials > this OAuth client > Client secret). Required
# to exchange an authorization code / refresh token server-side - the
# implicit flow used elsewhere never needed this.
GOOGLE_OAUTH_CLIENT_SECRET=

# TOKEN_ENCRYPTION_KEY: 32-byte key, base64-encoded, used to encrypt Google
# refresh tokens at rest (server/cryptoUtil.ts). Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# NOTIFY_LINK_SECRET: Signs the short-lived OAuth "state" round-trip and the
# one-click "push to calendar" links sent in notification emails/digests
# (server/notifyActionToken.ts). Any long random string.
NOTIFY_LINK_SECRET=

# RESEND_API_KEY: For sending user-facing "your plan is ready" email
# notifications (Auto Sync & Notify). Sign up at resend.com, verify a sending
# domain (or use their shared onboarding@resend.dev sender for a first cut).
RESEND_API_KEY=


