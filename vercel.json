{
  "rewrites": [
    {
      "source": "/api/feedback/eligibility",
      "destination": "/api/feedback"
    },
    {
      "source": "/api/feedback/submit",
      "destination": "/api/feedback"
    },
    {
      "source": "/api/feedback/admin-list",
      "destination": "/api/feedback?action=admin-list"
    },
    {
      "source": "/api/feedback/calendar-poll",
      "destination": "/api/feedback?action=calendar-poll"
    },
    {
      "source": "/api/auth/google/authorize",
      "destination": "/api/auth/google?action=authorize"
    },
    {
      "source": "/api/auth/google/status",
      "destination": "/api/auth/google?action=status"
    },
    {
      "source": "/api/auth/google/findings",
      "destination": "/api/auth/google?action=findings"
    },
    {
      "source": "/api/auth/google/calendar-push",
      "destination": "/api/auth/google?action=calendar-push"
    },
    {
      "source": "/api/auth/google/calendar-events",
      "destination": "/api/auth/google?action=calendar-events"
    },
    {
      "source": "/api/auth/account",
      "destination": "/api/auth/google?action=delete-account"
    },
    {
      "source": "/api/auth/ai-settings",
      "destination": "/api/auth/google?action=ai-settings"
    },
    {
      "source": "/api/auth/notify-prefs",
      "destination": "/api/auth/google?action=notify-prefs"
    },
    {
      "source": "/api/auth/session",
      "destination": "/api/auth/google?action=session"
    },
    {
      "source": "/api/presets/calibrate-offsets",
      "destination": "/api/presets?action=calibrate-offsets"
    },
    {
      "source": "/api/presets/smart-import",
      "destination": "/api/presets?action=smart-import"
    },
    {
      "source": "/api/agent/transcribe",
      "destination": "/api/agent?action=transcribe"
    },
    {
      "source": "/api/agent/process",
      "destination": "/api/agent?action=process"
    },
    {
      "source": "/api/agent/clarify",
      "destination": "/api/agent?action=clarify"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-report",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/agenda-scan",
      "schedule": "0 7 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
